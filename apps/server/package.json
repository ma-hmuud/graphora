    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@graphora/auth": "workspace:*",
    "@graphora/db": "workspace:*",
    "@graphora/env": "workspace:*",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/graphql": "^13.2.5",
    "@nestjs/mercurius": "^13.2.5",
    "@nestjs/platform-fastify": "^11.1.19",
    "@prisma/client": "^6.6.0",
    "@thallesp/nestjs-better-auth": "^2.6.0",
    "better-auth": "catalog:",
    "bullmq": "^5.21.2",
    "dotenv": "catalog:",
