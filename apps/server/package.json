{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@graphora/auth": "workspace:*",
    "@graphora/db": "workspace:*",
    "@graphora/env": "workspace:*",
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/graphql": "^13.2.5",
    "@nestjs/mercurius": "^13.2.5",
    "@nestjs/platform-fastify": "^11.1.19",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "fastify": "^5.3.3",
    "graphql": "^16.13.2",
    "mercurius": "^16.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphora/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "catalog:"
  }
}
