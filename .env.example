# ── Server (NestJS / Fastify) ──────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/graphora
BETTER_AUTH_SECRET=your-secret-at-least-32-chars-long
BETTER_AUTH_URL=https://your-server.onrender.com
CORS_ORIGIN=https://your-web.vercel.app
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-server.onrender.com/api/auth/callback/google
NODE_ENV=production
PORT=3001

# ── Web (Next.js) ────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=https://your-server.onrender.com
