# ── Server (NestJS / Fastify) ──────────────────────────────────
BETTER_AUTH_SECRET="your-secret"
BETTER_AUTH_URL="http://url"
CORS_ORIGIN="cor1,cor2"
PORT="port"

# Neon credentials
DATABASE_URL='database-url'

# Google credentials
GOOGLE_CLIENT_ID="client-id"
GOOGLE_CLIENT_SECRET="secret"
GOOGLE_REDIRECT_URI="uri"

# Email credentials
EMAIL_API_KEY="api-key"
EMAIL_VERIFICATION_TEMPLATE_ID="template-id"
EMAIL_USER="email"

# S3 credentials
AWS_ACCESS_KEY="access-key"
AWS_SECRET_ACCESS_KEY="secret-access-key"
AWS_REGION="region"
AWS_S3_BUCKET="bucket-name"

# Redis credentials
REDIS_USERNAME="username"
REDIS_PASSWORD="password"
REDIS_HOST="host"
REDIS_PORT="port"

SERVER_URL="url"

# ── Web (Next.js) ────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=https://your-server.onrender.com
