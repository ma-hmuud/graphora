{
  "name": "@graphora/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:generate": "prisma generate --schema=../../apps/server/src/prisma/schema.prisma",
    "db:push": "prisma db push --schema=../../apps/server/src/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=../../apps/server/src/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=../../apps/server/src/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "../../apps/server/src/prisma/schema.prisma"
  },
  "dependencies": {
    "@graphora/env": "workspace:*",
    "@prisma/client": "^6.6.0",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@graphora/config": "workspace:*",
    "prisma": "^6.6.0",
    "typescript": "catalog:"
  }
}
